{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "rm -rf dist && pnpm build:client",
  "outputDirectory": "dist/public",
  "functions": {
    "api/trpc/[...path].mjs": {
      "includeFiles": "dist/server/planner-app.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
