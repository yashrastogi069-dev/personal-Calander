# Copy to .env locally. Never commit real credentials.
# Required: public Supabase project configuration (also needed during Vercel build).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Required: server-only Supabase credentials.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Private files use the same Supabase project and server credentials above.
# Apply 0002_private_planner_files.sql after the ownership migration to create
# the private planner-files bucket (20 MiB; PDF, text, JSON, JPEG, PNG, WebP).
# Never expose SUPABASE_SERVICE_ROLE_KEY in a VITE_ variable.
# Optional user-owned web push; use your existing pair for existing devices.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Required for the authenticated scheduled reminder + cancelled-file cleanup worker.
# Use the deployment origin without a path. Use a long random server-only secret.
APP_ORIGIN=
REMINDER_CRON_SECRET=
# Store matching endpoint/secret in Supabase Vault as personal_calendar_reminder_url
# and personal_calendar_reminder_secret, then install supabase/cron/reminder_sweep.sql.
# Optional AI companion. Both endpoint and key must be explicitly configured.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# OPENROUTER_API_KEY may be used instead of OPENAI_API_KEY.
# Optional read-only calendar readiness; no feed is fetched automatically.
PERSONAL_CALENDAR_ICS_OVERLAY_URL=
